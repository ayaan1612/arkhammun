# ==============================================================================
# ARKHAM MUN BACKEND CONFIGURATION
# ==============================================================================

# Server HTTP Port
PORT=3001

# MongoDB Atlas Connection URI (REQUIRED for persistent storage on Vercel)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://arkham_user:your_password@cluster0.abcde.mongodb.net/arkhammun?retryWrites=true&w=majority

# JWT Authentication Secret Key (REQUIRED for signing user and admin tokens)
JWT_SECRET=generate-a-strong-secret-key-here-with-openssl-or-random-string

# First Administrator Email Address
# Any user registering with this email address automatically receives the 'admin' role.
ADMIN_EMAIL=admin@arkhammun.org

# Optional seed password for auto-created initial admin
ADMIN_PASSWORD=AdminArkham2026!

# Comma-separated allowed frontend origins for CORS (include your Vercel frontend URL)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://arkhammun.vercel.app

# Cryptographic secret used for signing and verifying venue entry pass QR codes
ENTRY_SECRET=replace-with-openssl-rand-hex-32

# Admin API passkey (Supported alongside JWT tokens for admin endpoints and venue scanner)
ADMIN_KEY=replace-with-openssl-rand-hex-32

# Default Conference Settings
ENTRY_FEE=2200
EVENT_NAME=Arkham MUN
EVENT_DATE=24–25 October 2026
EVENT_TIME=9:00 AM – 5:00 PM
EVENT_VENUE=Central Delhi, India

# SMTP Email Delivery Configuration (Optional - for sending approval/rejection emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Arkham MUN Secretariat" <registrations@arkhammun.org>
