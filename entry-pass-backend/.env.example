# HTTP port for the Express server.
PORT=3001

# Comma-separated browser origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Entry fee charged to each registration, in INR.
ENTRY_FEE=2200

# Event name shown in the registration and entry-pass flow.
EVENT_NAME=Arkham MUN

# Generate both secrets with: openssl rand -hex 32
# Used to sign entry QR payloads. Keep stable or previously issued passes stop verifying.
ENTRY_SECRET=replace-with-openssl-rand-hex-32
# Shared admin header key. Replace before use and keep it private.
ADMIN_KEY=replace-with-openssl-rand-hex-32

# SMTP Email Delivery Configuration (Optional in local development; required for approval emails)
# If SMTP_HOST is not set or placeholder, approval succeeds without sending an email.
# SMTP server hostname (e.g. smtp.gmail.com, smtp.mailgun.org, smtp.sendgrid.net)
SMTP_HOST=smtp.example.com
# Port: typically 587 for STARTTLS, 465 for SSL/TLS, 25/2525
SMTP_PORT=587
# Set to true for port 465 SSL, false for port 587 STARTTLS
SMTP_SECURE=false
# SMTP authentication username
SMTP_USER=user@example.com
# SMTP authentication password or app-specific password
SMTP_PASS=replace-with-smtp-password
# From header shown to delegates
SMTP_FROM="Arkham MUN Secretariat" <registrations@arkhammun.org>